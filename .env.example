# =============================================================================
# SENTINEL CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Optional - uses mock data if not set)
# -----------------------------------------------------------------------------
# CockroachDB Cloud (recommended for production)  
CRDB_CONNECTION_STRING=postgresql://username:password@host:26257/defaultdb?sslmode=require

# Local PostgreSQL alternative
# CRDB_CONNECTION_STRING=postgresql://localhost/sentinel_dev

# -----------------------------------------------------------------------------
# EMBEDDING PROVIDERS (Optional - uses local models if not set)
# -----------------------------------------------------------------------------

# AWS Bedrock (best for production - requires AWS account)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_REGION=us-east-1

# OpenAI (good alternative - requires API key)
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------  
# AI REASONING (Optional - uses fallback reasoning if not set)
# -----------------------------------------------------------------------------
# Uses same AWS credentials as above for Bedrock Claude

# -----------------------------------------------------------------------------
# AWS SERVICES (Optional - for cloud deployment)
# -----------------------------------------------------------------------------
AWS_S3_BUCKET=sentinel-logs-bucket
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/queue-name
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:account:sentinel-alerts

# Security Groups and WAF (for action execution)
SECURITY_GROUP_ID=sg-sentinel-managed
WAF_WEB_ACL_ID=sentinel-web-acl

# -----------------------------------------------------------------------------
# AGENT CONFIGURATION
# -----------------------------------------------------------------------------
SENTINEL_THREAT_THRESHOLD=5.0
SENTINEL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# DEVELOPMENT CONFIGURATION  
# -----------------------------------------------------------------------------
# API and Dashboard
DASHBOARD_PORT=3000
API_PORT=8000
API_GATEWAY_URL=https://api-gateway-id.execute-api.us-east-1.amazonaws.com/prod

# -----------------------------------------------------------------------------
# SETUP HELP
# -----------------------------------------------------------------------------
# 
# 🚀 QUICK START (No credentials needed):
#    python local_server.py
#
# 🔧 FULL SETUP:
#    1. python check_credentials.py  # Check your setup
#    2. python setup.py            # One-command setup  
#    3. python test_sentinel.py    # Verify everything works
#
# 📚 GUIDES:
#    - CREDENTIALS_SETUP.md - Detailed credential setup
#    - README.md - Complete documentation
#    - DEMO.md - Presentation guide
#