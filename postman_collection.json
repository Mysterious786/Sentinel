    {
      "name": "Load Testing - 100 Users",
      "item": [
        {
          "name": "Setup - Generate User List",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Generate 100 unique users and store in environment",
                  "const users = [];",
                  "const ips = ['192.168.1.', '10.0.0.', '172.16.0.', '203.0.113.', '198.51.100.', '192.0.2.'];",
                  "const countries = ['United States', 'United Kingdom', 'Germany', 'France', 'Russia', 'China', 'India', 'Brazil'];",
                  "",
                  "for (let i = 1; i <= 100; i++) {",
                  "  const ipPrefix = ips[Math.floor(Math.random() * ips.length)];",
                  "  const ipSuffix = Math.floor(Math.random() * 254) + 1;",
                  "  const country = countries[Math.floor(Math.random() * countries.length)];",
                  "  ",
                  "  users.push({",
                  "    id: i,",
                  "    username: `user${i}@sentinel.local`,",
                  "    ip: ipPrefix + ipSuffix,",
                  "    country: country,",
                  "    threatLevel: i % 3 === 0 ? 'high' : (i % 2 === 0 ? 'medium' : 'low')",
                  "  });",
                  "}",
                  "",
                  "pm.environment.set('users_list', JSON.stringify(users));",
                  "console.log('Generated 100 users for load testing');",
                  "pm.test('Users generated successfully', function() {",
                  "  pm.expect(users.length).to.equal(100);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "Load Test - Create 100 Events (Sequential)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Setup for sequential load test",
                  "const users = JSON.parse(pm.environment.get('users_list'));",
                  "const iteration = pm.environment.get('current_iteration') || 0;",
                  "const user = users[iteration % 100];",
                  "",
                  "// Set current user data",
                  "pm.environment.set('current_user_id', iteration % 100);",
                  "pm.environment.set('current_username', user.username);",
                  "pm.environment.set('current_ip', user.ip);",
                  "pm.environment.set('current_country', user.country);",
                  "pm.environment.set('threat_attempts', user.threatLevel === 'high' ? 8 : (user.threatLevel === 'medium' ? 3 : 1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const iteration = parseInt(pm.environment.get('current_iteration') || 0);",
                  "pm.environment.set('current_iteration', iteration + 1);",
                  "",
                  "pm.test('Event created successfully', function() {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "if (pm.response.ok) {",
                  "  const result = pm.response.json().simulation_result;",
                  "  console.log(`User ${iteration + 1}/100: Threat ${result.threat_score}, Action: ${result.action_taken}`);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_data\": {\n    \"event_type\": \"authentication\",\n    \"action\": \"login_attempt\",\n    \"source_ip\": \"{{current_ip}}\",\n    \"username\": \"{{current_username}}\",\n    \"timestamp\": \"{{$timestamp}}\",\n    \"auth\": {\n      \"success\": false,\n      \"method\": \"password\",\n      \"attempts\": {{threat_attempts}}\n    },\n    \"user_agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\",\n    \"geo_location\": {\n      \"country\": \"{{current_country}}\",\n      \"city\": \"Unknown\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/simulate",
              "host": ["{{base_url}}"],
              "path": ["simulate"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "current_iteration",
      "value": "0",
      "type": "string"
    }
  ]
}
